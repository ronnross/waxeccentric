{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.next", "!.turbo", "!node_modules", "!**/public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/kallos-sthenos/**"],
      "linter": {
        "rules": {
          "preset": "none"
        }
      },
      "javascript": {
        "formatter": {
          "quoteStyle": "double"
        }
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "on"
          }
        }
      }
    }
  ]
}
