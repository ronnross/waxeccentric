{
  "name": "waxeccentric",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@waxeccentric/www",
    "dev:kallos-sthenos": "turbo dev --filter=@waxeccentric/kallos-sthenos",
    "build": "turbo build",
    "start": "turbo start --filter=@waxeccentric/www",
    "start:kallos-sthenos": "turbo start --filter=@waxeccentric/kallos-sthenos",
    "test:kallos-sthenos": "npm run test:run --workspace=@waxeccentric/kallos-sthenos",
    "deploy": "./scripts/deploy.sh",
    "preview:build": "./scripts/preview-build.sh",
    "preview": "./scripts/preview.sh",
    "typecheck": "turbo typecheck",
    "lint": "biome lint .",
    "check": "biome check . && turbo typecheck",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "turbo": "^2.6.3"
  }
}
